# Environment Configuration Example
# Copy this to .env.local for local development or set in Vercel Dashboard for production

# Application Configuration
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0
VITE_APP_DOMAIN=localhost:5173

# Vercel Analytics & Speed Insights
# These work automatically when deployed on Vercel - no environment variables needed!
# Just enable Analytics and Speed Insights in your Vercel dashboard

# Performance & Monitoring
VITE_ENABLE_MONITORING=true
VITE_ENABLE_PERFORMANCE_DASHBOARD=true

# Feature Flags
VITE_ENABLE_SERVICE_WORKER=true
VITE_ENABLE_OFFLINE_MODE=true

# PostHog Analytics Configuration
# For production: Set these in your Vercel dashboard
# For development: Leave VITE_ENABLE_POSTHOG=false to disable analytics
VITE_ENABLE_POSTHOG=false
VITE_PUBLIC_POSTHOG_KEY=phc_aziz7u0fLPoGaaueJ7zYrKsjEQZvmkh3nWRiuT6ZttU
VITE_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Contact API / Resend (server-side; never expose the API key to the client)
# Create a key at https://resend.com/api-keys and set the same values in Vercel.
# RESEND_FROM must use a domain verified in Resend. Use a send. subdomain so
# the DNS records stay off the domain that already receives mail.
# Until send.theodorosmentis.com is verified, Resend only delivers test mail
# from onboarding@resend.dev to the Resend account email.
RESEND_API_KEY=re_your_api_key
RESEND_FROM=Portfolio <notifications@send.theodorosmentis.com>
CONTACT_EMAIL=contact@theodorosmentis.com
PUBLIC_SITE_ORIGIN=https://www.theodorosmentis.com

# Secret used to sign stateless CSRF tokens (api/contact/csrf.ts).
# Set a long random value in the Vercel dashboard. If unset, a static fallback
# is used; the double-submit cookie still protects against CSRF, but a real
# secret is recommended for token integrity.
CSRF_SECRET=change-me-to-a-long-random-string

# Security
VITE_SECURITY_HEADERS_ENABLED=true
